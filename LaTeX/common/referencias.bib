@article{westwick_2018,
  abstract  = {The polynomial NARX model, where the output is a polynomial function of past inputs and outputs, is a commonly used equation error model for nonlinear systems. While it is linear in the variables, which simpliﬁes its identiﬁcation, it suﬀers from two major drawbacks: the number of parameters grows combinatorially with the degree of the nonlinearity, and it is a black box model, which makes it diﬃcult to draw any insights from the identiﬁed model. Polynomial decoupling techniques are used to replace the multiple-input single-output polynomial with a decoupled polynomial structure comprising a transformation matrix followed by bank of SISO polynomials, whose outputs are then summed. This approach is demonstrated on two benchmark systems: The Bouc-Wen friction model and the data from the Silverbox model. In both cases, the decoupling results in a substantial reduction in the number of parameters, and allows some insight into the nature of the nonlinearities in the system.},
  author    = {Westwick, David T. and Hollander, Gabriel and Karami, Kiana and Schoukens, Johan},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  doi       = {10.1016/j.ifacol.2018.09.133},
  issn      = {24058963},
  journal   = {IFAC-PapersOnLine},
  language  = {en},
  number    = {15},
  pages     = {796--801},
  title     = {Using {Decoupling} {Methods} to {Reduce} {Polynomial} {NARX} {Models}},
  url       = {https://linkinghub.elsevier.com/retrieve/pii/S2405896318317944},
  urldate   = {2025-09-27},
  volume    = {51},
  year      = {2018},
}

